pkgname=source-record
pkgver=0.1.1
pkgrel=1
pkgdesc='Independent FFmpeg camera recorder with live preview and Omarchy bar controls'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-svg' 'ffmpeg' 'libpulse')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/source-record "$pkgdir/usr/bin/source-record"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/source-record.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/source-record.svg"
  install -Dm644 "$startdir/source-record.desktop" "$pkgdir/usr/share/applications/source-record.desktop"
  install -Dm644 README.md "$pkgdir/usr/share/doc/source-record/README.md"
  install -d "$pkgdir/usr/share/source-record/plugin"
  cp -R plugin/. "$pkgdir/usr/share/source-record/plugin/"
}
