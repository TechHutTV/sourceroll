pkgname=multitake
pkgver=0.5.0
pkgrel=1
pkgdesc='Record screen, camera, microphone and desktop audio as separate synchronized takes'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-svg' 'ffmpeg' 'libpulse' 'gpu-screen-recorder' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/multitake "$pkgdir/usr/bin/multitake"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/multitake.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/multitake.svg"
  install -Dm644 "$startdir/multitake.desktop" "$pkgdir/usr/share/applications/multitake.desktop"
  install -Dm644 README.md "$pkgdir/usr/share/doc/multitake/README.md"
  install -d "$pkgdir/usr/share/multitake/plugin"
  cp -R plugin/. "$pkgdir/usr/share/multitake/plugin/"
}
